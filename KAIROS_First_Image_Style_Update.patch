+}
+
+/* KAIROS illustration refinement: reference-inspired Japanese scenic header.
+   Decoration only; existing data, controls and layouts remain unchanged. */
+.kairos-sakura-theme .topbar { position: relative; z-index: 2; }
+.kairos-sakura-theme .page-heading {
+  position: relative;
+  isolation: isolate;
+  min-height: 224px;
+}
+.kairos-sakura-theme .page-heading > div:first-child {
+  position: relative;
+  z-index: 1;
+  max-width: min(78%, 820px);
+}
+.kairos-sakura-theme .kairos-hero-art {
+  position: absolute;
+  z-index: 0;
+  top: -122px;
+  right: -36px;
+  width: min(70vw, 780px);
+  height: 355px;
+  overflow: hidden;
+  pointer-events: none;
+  user-select: none;
+}
+.kairos-sakura-theme .kairos-hero-svg {
+  display: block;
+  width: 100%;
+  height: 100%;
+  object-fit: contain;
+  pointer-events: none;
+}
+/* The same subtle ink-wave accent framing the target reference, kept off text. */
+.kairos-sakura-theme .page-heading::before {
+  content: '';
+  position: absolute;
+  left: -36px;
+  top: 75px;
+  width: 128px;
+  height: 115px;
+  pointer-events: none;
+  opacity: .38;
+  background: repeating-radial-gradient(circle at 50% 100%,
+    transparent 0 10px, rgba(179, 139, 87, .23) 11px 12px, transparent 13px 23px);
+  mask-image: linear-gradient(to right, #000, transparent);
+}
+/* Keep the existing Lovable cherry branches, but do not let them cross the logo. */
+.kairos-sakura-theme .sidebar .kairos-deco-sakura__upper {
+  right: -65px;
+  top: 12px;
+  opacity: .8;
+}
+.kairos-sakura-theme .sidebar .kairos-deco-sakura__lower { opacity: .65; }
+@media (max-width: 1350px) {
+  .kairos-sakura-theme .kairos-hero-art { width: min(64vw, 680px); right: -28px; }
+  .kairos-sakura-theme .page-heading > div:first-child { max-width: 78%; }
+}
+@media (max-width: 1050px) {
+  .kairos-sakura-theme .kairos-hero-art { width: 530px; top: -95px; opacity: .72; }
+  .kairos-sakura-theme .page-heading > div:first-child { max-width: 82%; }
+}
+@media (max-width: 950px) {
+  .kairos-sakura-theme .page-heading { min-height: 165px; }
+  .kairos-sakura-theme .page-heading > div:first-child { max-width: 100%; }
+  .kairos-sakura-theme .kairos-hero-art { width: 380px; right: -20px; top: -58px; opacity: .22; }
+  .kairos-sakura-theme .page-heading::before { display: none; }
+  .kairos-sakura-theme .sidebar .kairos-deco-sakura__upper { opacity: .35; }
+}
+@media (max-width: 600px) {
+  .kairos-sakura-theme .page-heading { min-height: 0; }
+  .kairos-sakura-theme .kairos-hero-art { display: none; }
+}
