# Comma-separated exact origins; add your Vercel origin explicitly.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# PASS 12B: optional Groq ranking for the actual enterprise v2 workspace.
# Set in backend/.env, NOT src/ or .env.local. Disabled until explicitly enabled.
KAIROS_GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
KAIROS_GROQ_DAILY_CALL_LIMIT=60
