   .kairos-sakura-theme .workspace-content.with-explanation { grid-template-columns: 1fr; }
   .kairos-sakura-theme .explanation { position: static; }
-  .kairos-sakura-theme .hero-motif { width: 175px; transform: scale(.85); transform-origin: right center; margin-left: -20px; }
