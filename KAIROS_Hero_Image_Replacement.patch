--- a/src/styles/kairos-sakura-theme.css
+++ b/src/styles/kairos-sakura-theme.css
@@ -28,20 +28,42 @@
 .kairos-sakura-theme .mode-pill { color: var(--ink); background: var(--card); border-color: var(--border); font-size: 10px; padding: 11px; white-space: nowrap; }
 .kairos-sakura-theme .mode-pill>span { background: #16765c; }
 .kairos-sakura-theme main { padding: 38px 36px 0; }
-.kairos-sakura-theme .page-heading { align-items: center; gap: 24px; min-height: 210px; margin-bottom: 30px; }
-.kairos-sakura-theme .page-heading>div:first-child { min-width: 0; }
+.kairos-sakura-theme .page-heading { align-items: center; gap: 28px; min-height: 210px; margin-bottom: 30px; justify-content: space-between; }
+.kairos-sakura-theme .page-heading>div:first-child { min-width: 0; flex: 1 1 420px; }
 .kairos-sakura-theme .page-heading h1 { font: 600 clamp(38px,3.6vw,52px)/1.08 Georgia, 'Times New Roman', serif; letter-spacing: -1.8px; color: var(--ink); }
 .kairos-sakura-theme .page-heading h1 span { color: var(--ink); }
 .kairos-sakura-theme .page-heading p { font-size: 16px; color: var(--muted); max-width: 740px; }
 .kairos-sakura-theme .eyebrow { font-size: 11px; color: var(--ink); letter-spacing: 2px; }
 .kairos-sakura-theme .red-line { background: var(--red); width: 27px; }
-/* One solid sun, a quiet mountain, and edge petals, all outside interaction targets. */
-.kairos-sakura-theme .hero-motif { width: 218px; height: 216px; margin: 0; pointer-events: none; }
-.kairos-sakura-theme .sun { width: 156px; height: 156px; left: 45px; top: 22px; background: #9E1628; opacity: 1; }
-.kairos-sakura-theme .hero-motif:before { border: 0; border-radius: 0; width: 210px; height: 85px; left: 0; top: 128px; z-index: 1; background: #84909a; clip-path: polygon(0 100%, 23% 70%, 49% 0, 72% 71%, 100% 100%); }
-.kairos-sakura-theme .hero-motif:after { border: 0; border-radius: 0; width: 74px; height: 37px; left: 66px; top: 128px; z-index: 2; background: var(--paper); clip-path: polygon(50% 0,100% 100%,68% 69%,55% 86%,41% 62%,0 100%); }
-.kairos-sakura-theme .motif-lines { width: 13px; height: 22px; left: 16px; top: 24px; border-radius: 85% 0 85% 0; background: var(--sakura); opacity: .65; transform: rotate(25deg); box-shadow: 161px -13px 0 #EAA3B5, 184px 81px 0 #EAA3B5, -4px 82px 0 #EAA3B5; }
-.kairos-sakura-theme .hero-motif>span { display: none; }
+/* Replace the generic geometric hero with curated Fuji artwork generated for KAIROS. */
+.kairos-sakura-theme .hero-motif {
+  width: min(46vw, 720px);
+  max-width: 720px;
+  min-width: 360px;
+  height: auto;
+  margin: 0;
+  pointer-events: none;
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  flex: 0 1 720px;
+}
+.kairos-sakura-theme .hero-motif--art img {
+  display: block;
+  width: 100%;
+  height: auto;
+  object-fit: contain;
+  object-position: right center;
+  user-select: none;
+  filter: saturate(1.02) contrast(1.01);
+}
+.kairos-sakura-theme .hero-motif::before,
+.kairos-sakura-theme .hero-motif::after,
+.kairos-sakura-theme .hero-motif .sun,
+.kairos-sakura-theme .hero-motif .motif-lines,
+.kairos-sakura-theme .hero-motif > span {
+  display: none !important;
+}
 .kairos-sakura-theme :is(.command-section,.widget,.explanation,.suggestion,.enterprise-evidence,.fw-surface,.saved-panel,.account-panel,.ks-dialog) { background: var(--card); color: var(--ink); border-color: var(--border); box-shadow: 0 4px 18px #36291d07; border-radius: 14px; }
 .kairos-sakura-theme .command-top { padding: 22px 24px 0; gap: 14px; color: var(--ink); }
 .kairos-sakura-theme .command-top>span:first-child { font: 600 22px Georgia,serif; }
