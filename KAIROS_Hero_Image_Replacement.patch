     <aside className="sidebar"><a className="brand" href="#main" onClick={e => { e.preventDefault(); reset(); }} aria-label="KAIROS home"><span className="brand-mark"><span/></span><span>カイロス <small>KAIROS</small></span></a><div className="workspace-label">YOUR SPACE <span>01</span></div><nav aria-label="Main navigation"><button className={plan.intent === 'overview' ? 'nav-item active' : 'nav-item'} onClick={reset}><LayoutDashboard size={18}/> Overview</button>{suggestions.map((s, i) => <button key={s.tag} className={`nav-item ${plan.intent === ['meeting', 'usage', 'projects'][i] ? 'active' : ''}`} disabled={busy} onClick={() => void submit(s.input)}><s.icon size={18}/>{['Meeting prep', 'Usage insights', 'Project review'][i]}</button>)}<div className="nav-divider"/><button className="nav-item" disabled={busy} onClick={() => user ? setMeetingComposer(true) : setAccountOpen(true)}><CalendarDays size={18}/> Schedule a meeting</button><button className="nav-item" onClick={() => void showHistory()}><Save size={18}/> Saved workspaces</button></nav><div className="sidebar-bottom"><div className="kai-card"><Kai state={state} compact/><p>A workspace that<br/>thinks with you.</p><span>Less searching. More doing.</span></div><div className="event-label"><span className="red-dot"/> BUILT FOR HACKWAVE 3.0</div><button className="profile-button" onClick={() => setAccountOpen(!accountOpen)}><span className="avatar small"><UserRound size={16}/></span><span>{user?.email?.split('@')[0] || 'Employee'}<small>{user ? 'Connected account' : 'Employee access'}</small></span><ChevronDown size={14}/></button></div></aside>
     <div className="app-body"><header className="topbar"><div className="breadcrumb">Workspace <span>/</span> <strong>{enterprise ? enterprise.title : plan.intent === 'overview' ? 'Overview' : plan.intent === 'meeting' ? 'Meeting preparation' : plan.intent === 'usage' ? 'Usage investigation' : 'Project review'}</strong></div><div className="topbar-actions"><span className="mode-pill"><span/>{enterprise || connected ? 'CONNECTED DATA' : 'LOCAL DATA'}</span><button className="icon-button" aria-label="Account settings" onClick={() => setAccountOpen(!accountOpen)}><UserRound size={18}/></button></div></header>
